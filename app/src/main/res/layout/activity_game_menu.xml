<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#121212">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:minHeight="?attr/actionBarSize"
        app:title="7 Wonders Score"
        app:titleTextColor="#FFD700" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="32dp"/>

    <!-- NEW GAME BUTTON -->
    <ImageButton
        android:id="@+id/btnNewGame"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:contentDescription="New Game"
        android:focusable="true"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_new_game" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="24dp" />

    <!-- RESULTS BUTTON -->
    <ImageButton
        android:id="@+id/btnResults"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:contentDescription="Results"
        android:focusable="true"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_results" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="24dp" />

    <!-- STATISTICS BUTTON -->
    <ImageButton
        android:id="@+id/btnStatistics"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:contentDescription="Statistics"
        android:focusable="true"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_statistics" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="32dp" />
</LinearLayout>
